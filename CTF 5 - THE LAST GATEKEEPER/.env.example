# CTF 5 — THE LAST GATEKEEPER: SPLIT SEAL — environment template
#
# Copy to `.env` for docker compose (never commit a real value), or export
# the variables in your shell before `npm start`. All variables are optional.

# Web UI + API + WebSocket bridge (default 8083)
PORT=8083

# Raw challenge listener for `nc HOST 31337` (default 31337, 0 disables)
TCP_PORT=31337

# Organizer-only flag rotation. Leave unset in normal operation: the server
# validates against a built-in one-way commitment. NEVER commit a real value.
SPLIT_SEAL_FLAG=

# Where completion state is persisted (default server/data)
# DATA_DIR=

# Session hygiene
# MAX_SESSIONS=8
# SESSION_IDLE_MS=600000

# External challenge service mode (skip local spawn/VM):
# GATEKEEPER_TCP_HOST=127.0.0.1
# GATEKEEPER_TCP_PORT=31338

# Windows dev-host challenge VM overrides (see challenge/runtime/README.txt)
# QEMU_BIN=...  QEMU_KERNEL=...  QEMU_INITRAMFS=...  VM_HOST_PORT=13137  VM_RAM_MB=160
