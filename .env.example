# ===========================================================================
# THE LAST DATASET — environment configuration (example)
# Copy to .env and fill in real values. Never commit .env.
# ===========================================================================

# --- HTTP -------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Trust X-Forwarded-* when running behind a reverse proxy (Render/Railway/Fly/VPS+nginx)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Production (managed Postgres or docker-compose):
DATABASE_URL=postgres://postgres:change-me@localhost:5432/thelastdataset
# Easy local development (embedded Postgres, zero setup) — also the default:
# DATABASE_URL=pglite://./.data/db

# --- Auth -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- CTF integration --------------------------------------------------------
# Shared secret your external CTF backends send to POST /api/integrations/ctf-complete
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CTF_SERVICE_TOKEN=

# --- First administrator (created by `npm run seed` when no admin exists) ----
ADMIN_EMAIL=admin@sanctuary.local
# Preferred: pre-computed bcrypt hash (npm run seed -- --hash '…') — avoids plaintext.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- Frontend / CORS --------------------------------------------------------
# Only needed when the frontend is hosted separately from this API.
FRONTEND_URL=https://game.example.com
# Comma-separated allowed origins. Leave empty to reflect the request origin
# (the default, correct for the bundled same-origin deployment).
CORS_ORIGIN=

# --- Event timing -----------------------------------------------------------
EVENT_NAME=THE LAST DATASET // SANCTUARY ZERO
EVENT_START=2026-11-01T09:00:00.000Z
EVENT_END=2026-11-01T21:00:00.000Z

# --- URL policy -------------------------------------------------------------
# Allow http:// and localhost CTF URLs (development only — keep false in prod)
ALLOW_LOCAL_URLS=false
ALLOW_INSECURE_HTTP=false

# --- Public challenge links -------------------------------------------------
# The public address of each in-world challenge service, one per terminal,
# served to the game at GET /api/ctf/links so a deployed page never points a
# player at their own localhost. Use complete https:// addresses (http:// and
# local/private hosts are refused in production). Leave a value empty to keep
# that terminal "CTF CHANNEL NOT CONFIGURED" - the rest of the game still runs.
#     CTF_URL_1  GHOST SIGNAL       CTF_URL_4  CENTRAL ATRIUM (bonus)
#     CTF_URL_2  SANCTUARY ARCHIVE  CTF_URL_5  BIOARCHIVE (final gate)
#     CTF_URL_3  CHILD DATASET
CTF_URL_1=
CTF_URL_2=
CTF_URL_3=
CTF_URL_4=
CTF_URL_5=

# --- Local challenge autostart ----------------------------------------------
# `npm start` starts the five challenge services as child processes on this
# machine and stops them again with the game server. Best effort only: a
# challenge that is missing stays "not configured" and never blocks the game.
# Set <n>_AUTOSTART=false to run a service yourself (or on another host), and
# <n>_PORT to move it off its default. Defaults: 8080, 8081, 8082, 8090, 8083.
CTF1_AUTOSTART=true
CTF1_PORT=8080
CTF2_AUTOSTART=true
CTF2_PORT=8081
CTF3_AUTOSTART=true
CTF3_PORT=8082
CTF4_AUTOSTART=true
CTF4_PORT=8090
CTF5_AUTOSTART=true
CTF5_PORT=8083
