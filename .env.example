# ===========================================================================
# THE LAST DATASET — environment configuration (example)
# Copy to .env and fill in real values. Never commit .env.
# ===========================================================================

# --- HTTP -------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Trust X-Forwarded-* when running behind a reverse proxy (Render/Railway/Fly/VPS+nginx)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Production (managed Postgres or docker-compose):
DATABASE_URL=postgres://postgres:change-me@localhost:5432/thelastdataset
# Easy local development (embedded Postgres, zero setup) — also the default:
# DATABASE_URL=pglite://./.data/db

# --- Auth -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- CTF integration --------------------------------------------------------
# Shared secret your external CTF backends send to POST /api/integrations/ctf-complete
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CTF_SERVICE_TOKEN=

# --- First administrator (created by `npm run seed` when no admin exists) ----
ADMIN_EMAIL=admin@sanctuary.local
# Preferred: pre-computed bcrypt hash (npm run seed -- --hash '…') — avoids plaintext.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- Frontend / CORS --------------------------------------------------------
# Only needed when the frontend is hosted separately from this API.
FRONTEND_URL=https://game.example.com
# Comma-separated allowed origins. Leave empty to reflect the request origin
# (the default, correct for the bundled same-origin deployment).
CORS_ORIGIN=

# --- Event timing -----------------------------------------------------------
EVENT_NAME=THE LAST DATASET // SANCTUARY ZERO
EVENT_START=2026-11-01T09:00:00.000Z
EVENT_END=2026-11-01T21:00:00.000Z

# --- URL policy -------------------------------------------------------------
# Allow http:// and localhost CTF URLs (development only — keep false in prod)
ALLOW_LOCAL_URLS=false
ALLOW_INSECURE_HTTP=false
