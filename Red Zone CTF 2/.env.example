# Red Zone CTF 2 — environment (copy to `.env` to use)
#
# PORT          HTTP port for the archive node        (default 8081)
# RED_ZONE_FLAG authoritative expected flag. When set it is used verbatim
#                 and the dataset-derived flag is ignored.
#                 Leave unset for the deterministic dataset-derived flag.
# SHOW_FLAG=1    print the expected flag to the server console at boot.
#                 Organizer use only — never expose console output to players.

PORT=8081
# RED_ZONE_FLAG=RZ{...}
# SHOW_FLAG=1
